# Allworld settings: every one is optional. With none of them the game runs complete for guests on this machine:
# no sign-in, no e-mail, no analytics, no outside service.
#
# To use some, copy this file to .env (git-ignored), uncomment the lines you need, then:
#   npm run dev -- --env .env                        development
#   node --env-file=.env server/server.ts            the built game (after npm run build)
# The file is read by Node's own parser, never by a shell. Do not commit real values.
# What each setting does in detail: docs/REFERENCE.md.

# --- Server -------------------------------------------------------------------------------------------------------
# PORT=3001                     # port of `npm start` (8787 for `npm run start:worker`). `npm run dev` uses --port or DEV_PORT instead
# DEV_PORT=5173                 # port of `npm run dev`
# DATA_DIR=./.data              # where the server keeps its data file
# SESSION_TTL_DAYS=30           # lifetime of a device session
# TRUST_PROXY=1                 # only behind one trusted HTTPS reverse proxy
# HEARTBEAT_SECONDS=10          # how often sockets are pinged (1-60)
# STORE_WRITE_MB_PER_S=50       # write budget of the data file
# BUILD_ID=local                # recorded in problem reports and telemetry
# PUBLIC_ORIGIN=                # the game's public address (https://...), used in link previews and e-mail links
# MODERATOR_TOKEN=              # SECRET, 24+ characters. Unset: the /api/mod/* operator routes do not exist
# VOTES_PER_ADDRESS=3           # votes from one network address in one election before it is flagged (0: off)
# VOTE_CAP_MODE=flag            # flag | refuse
# MAX_ACTIVE_SESSIONS=10000     # stored device sessions; a new visitor beyond it waits ("the world is full"). docs/CAPACITY.md
# MAX_SOCKETS=4000              # open sockets in all (a page holds two); beyond it a new socket is told to try again later
# SOCKETS_PER_ADDRESS=32        # open sockets one network address may hold
# NEW_SESSIONS_PER_ADDRESS=300  # new players one network address may start in an hour (a campus or a mobile network is one address)

# --- Accounts (unset: no sign-in is shown; everybody plays as a guest) ---------------------------------------------
# ACCOUNTS_FIREBASE_PROJECT_ID= # the identity provider project whose ID tokens the server accepts
# ACCOUNTS_FIREBASE_API_KEY=    # that project's web API key (public: it is sent to the browser)
# ACCOUNTS_GOOGLE_CLIENT_ID=    # optional: OAuth web client id of the Google button (public)
# FOUNDER_EMAIL_SHA256=         # SHA-256 (64 hex characters) of the account that is every newcomer's first friend; empty: nobody

# --- E-mail and push (unset: dry-run; messages are composed and kept as previews, nothing is sent) -----------------
# ZEPTOMAIL_AUTH=               # SECRET: the Authorization value of the mail agent
# EMAIL_FROM_ADDRESS=           # sender address on a verified domain
# EMAIL_FROM_NAME=Allworld      # sender display name
# EMAIL_CONTACT_LINE=           # contact line printed at the foot of every e-mail
# EMAIL_DAILY_CAP=500           # most scheduled e-mails in one day
# VAPID_PUBLIC_KEY=             # web-push key pair (base64url). Unset: a pair is made once and kept under DATA_DIR
# VAPID_PRIVATE_KEY=            # SECRET
# VAPID_SUBJECT=                # contact for push services (mailto: or https:)
# PUSH_DAILY_CAP=5000           # most scheduled notifications in one day
# WHATSAPP_CHANNEL_URL=         # shows a "Follow on WhatsApp" link; no WhatsApp API is used

# --- Telemetry (unset: off; no request is made and no SDK is downloaded) -------------------------------------------
# TELEMETRY_ENV=                # production | staging | dev. Required once any key below is set
# TELEMETRY_DEBUG=1             # also run on localhost and with TELEMETRY_ENV=dev (for testing the wiring)
# SENTRY_DSN_CLIENT=            # browser error monitoring (public)
# SENTRY_DSN_SERVER=            # server error monitoring
# POSTHOG_KEY=                  # product analytics project key (public)
# POSTHOG_HOST=                 # analytics ingestion host
# TELEMETRY_CONSENT_AT=reward   # reward | landing: when the consent sheet is first shown
# TELEMETRY_REPLAY_ON_ERROR=1   # opt in to masked session replay for sessions that hit an error
# TELEMETRY_SLOW_MS=1000        # an API request slower than this may be reported

# --- Worker host only (deploy/) --------------------------------------------------------------------------------------
# SLEEP_BETWEEN_BEATS=1         # let the Worker's object sleep between heartbeats
# TURN_KEY_ID=                  # voice relay for nominated test players; unset: calls use STUN only
# TURN_API_TOKEN=               # SECRET
# TURN_TEST_PUBLIC_IDS=         # comma-separated public ids allowed to use the relay

# --- Build and tooling ---------------------------------------------------------------------------------------------
# SOURCEMAPS=1                  # `npm run build` also writes hidden source maps to dist-maps/
# SENTRY_AUTH_TOKEN=            # SECRET, with SENTRY_ORG and SENTRY_PROJECT: only for `npm run sentry:sourcemaps`
# CHROME_PATH=                  # a Chromium binary for the model and campus capture tools

# --- Hosted companion (unset key: the in-game guide answers from its own built-in replies; no outside call is ever made) ----
# AI_GATEWAY_API_KEY=           # SECRET. One key for the language-model gateway. Never sent to a browser, never logged. docs/COMPANION.md
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh   # the gateway's address (https only)
# COMPANION_MODEL=openai/gpt-5.6-luna                # the model asked first
# COMPANION_FALLBACK_MODEL=xai/grok-4.1-fast-non-reasoning   # asked once if the first fails, is busy or is slow
# COMPANION_AI=on               # on | off. Default: on when a key exists. off: the built-in replies only
# COMPANION_DAILY_REQUESTS=25000# model requests for everybody together, in a rolling day
# COMPANION_PLAYER_DAILY=200    # model requests one player may make in a rolling day
# COMPANION_PLAYER_BURST=8     # model requests one player may make in a minute
# COMPANION_MAX_OUTPUT_TOKENS=220   # the longest answer asked for
# COMPANION_TIMEOUT_MS=8000     # the most one question may wait for a model, both tries together
# COMPANION_AI_REPHRASE=off     # on: the guide may be asked to re-word its own built-in lines in its voice
# COMPANION_PRICE_IN_PER_M=0.10   # US$ per million input tokens: only for the operator's estimated cost
# COMPANION_PRICE_OUT_PER_M=0.50  # US$ per million output tokens: the same

# ---- the launch bonus (docs/LAUNCH-BONUS.md): in-game naira for the first players to sign up, once per account ----
# LAUNCH_BONUS=on                  # off: nobody new is given a place (places already reserved are still paid). Also a setting on the admin screen
# LAUNCH_BONUS_AMOUNT=1000000      # naira in the game for each place. Also a setting on the admin screen
# LAUNCH_BONUS_PLACES=10000        # how many accounts may claim; the offer ends when they have. Also a setting on the admin screen
# LAUNCH_BONUS_PER_ADDRESS_DAY=20  # payments a day from one network address (an IPv4 address or an IPv6 /64); past it a payment waits, it is not lost
