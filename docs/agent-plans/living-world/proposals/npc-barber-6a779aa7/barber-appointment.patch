+test('valid active strokes produce one immutable appointment effect; a retained terminal row never emits it again', () => {
+  const state = active(), finished = finishBarberAppointment(state, { actorId: ACTOR, expectedRevision: state.revision, sessionId: SESSION, now: 200,
+    currentLook: look, consentGeneration: 1, customerPresent: true, practiceSessionId: SESSION, practice: completePractice() })
+  assert.ok(finished.ok && finished.state && finished.effect)
+  assert.deepEqual([finished.state.status, finished.state.result?.styleId, finished.effect.gameCashCredit], ['completed', APPOINTMENT_STYLE_ID, NPC_APPOINTMENT_GAME_PAYMENT])
+  assert.ok(Object.isFrozen(finished.effect) && Object.isFrozen(finished.effect.appearance))
+  if (finished.effect.appearance.accessories) assert.ok(Object.isFrozen(finished.effect.appearance.accessories))
+  const replay = finishBarberAppointment(finished.state, { actorId: ACTOR, expectedRevision: finished.state.revision, sessionId: SESSION, now: 201,
+    currentLook: finished.state.result!.look, consentGeneration: 1, customerPresent: true, practiceSessionId: SESSION, practice: completePractice() })
+  assert.deepEqual([replay.code, replay.effect, replay.state?.result], ['already_completed', null, finished.state.result])
