+test('every successful transition round-trips and refuses backwards trusted time', () => {
+  const offered = offer(); assert.ok(offered)
+  assert.deepEqual(readBarberAppointment(offered, ACTOR), offered)
+  assert.equal(acceptBarberAppointment(offered, ACTOR, offered.revision, look, 1, 99, SESSION).code, 'clock_reversed')
+  const accepted = acceptBarberAppointment(offered, ACTOR, offered.revision, look, 1, 101, SESSION)
+  assert.ok(accepted.ok && accepted.state)
+  assert.deepEqual(readBarberAppointment(accepted.state, ACTOR), accepted.state)
+  const rollbackFinish = finishBarberAppointment(accepted.state, { actorId: ACTOR, expectedRevision: accepted.state.revision, sessionId: SESSION,
+    now: 100, currentLook: look, consentGeneration: 1, customerPresent: true, practiceSessionId: SESSION, practice: completePractice() })
+  assert.equal(rollbackFinish.code, 'clock_reversed')
+  assert.equal(rollbackFinish.effect, null)
+  const rollbackCancel = cancelBarberAppointment(accepted.state, ACTOR, accepted.state.revision, 'declined', 100)
+  assert.equal(rollbackCancel.code, 'clock_reversed')
+  assert.equal(rollbackCancel.effect, null)
+  const cancelled = cancelBarberAppointment(accepted.state, ACTOR, accepted.state.revision, 'declined', 102)
+  assert.ok(cancelled.ok && cancelled.state)
+  assert.deepEqual(readBarberAppointment(cancelled.state, ACTOR), cancelled.state)
+  const finished = finishBarberAppointment(accepted.state, { actorId: ACTOR, expectedRevision: accepted.state.revision, sessionId: SESSION,
+    now: 200, currentLook: look, consentGeneration: 1, customerPresent: true, practiceSessionId: SESSION, practice: completePractice() })
+  assert.ok(finished.ok && finished.state)
+  assert.deepEqual(readBarberAppointment(finished.state, ACTOR), finished.state)
+  assert.equal(readBarberAppointment({ ...finished.state, acceptedAt: offered.terms.issuedAt - 1 }, ACTOR), null,
+    'a completed record cannot place acceptance before offer issuance')
+  const invalidReason = Reflect.apply(cancelBarberAppointment, undefined, [accepted.state, ACTOR, accepted.state.revision, 'not-a-reason', 102]) as { code: string; effect: unknown }
+  assert.equal(invalidReason.code, 'invalid')
+  assert.equal(invalidReason.effect, null)
