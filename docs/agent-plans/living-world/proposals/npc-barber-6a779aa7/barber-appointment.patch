+test('revocation, disappearance, expiry, or changed complete appearance cancel before settlement', () => {
+  const scenarios = [
+    { currentLook: look, consentGeneration: 2, now: 200, customerPresent: true, reason: 'revoked' },
+    { currentLook: look, consentGeneration: 1, now: 200, customerPresent: false, reason: 'departed' },
+    { currentLook: look, consentGeneration: 1, now: 10_000, customerPresent: true, reason: 'expired' },
+    { currentLook: { ...look, outfitColor: 'red' }, consentGeneration: 1, now: 200, customerPresent: true, reason: 'appearance_changed' },
+  ] as const
+  for (const scenario of scenarios) {
