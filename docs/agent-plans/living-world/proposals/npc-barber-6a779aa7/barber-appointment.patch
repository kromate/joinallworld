--- /dev/null
+++ b/src/game/living-world/barber-appointment.test.ts
@@ -0,0 +1,139 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { APPEARANCE } from '../content/traits.ts'
+import { barberLesson } from './barber-catalogue.ts'
+import { readValidatedBarberPractice, startBarberPractice, stepBarberPractice, type BarberPracticeState } from './barber.ts'
+import { acceptBarberAppointment, cancelBarberAppointment, createConsentedBarberAppointment, finishBarberAppointment,
+  readBarberAppointment, APPOINTMENT_CUSTOMER_ID, APPOINTMENT_STYLE_ID, NPC_APPOINTMENT_GAME_PAYMENT } from './barber-appointment.ts'
+
+// The proposed 80 payment is policy-only until a server route/wallet/appearance transaction is integrated.
+const ACTOR = 'fixture-actor', SESSION = 'fixture-session'
+const look = { body: 'man', hair: 'curls', outfit: 'casual', fabric: 'plain', skin: 'skin-4', hairColor: 'black', outfitColor: 'blue', bottomsColor: 'navy' } as const
+const offer = () => createConsentedBarberAppointment({ appointmentId: 'appointment-1', actorId: ACTOR, currentLook: look,
+  issuedAt: 100, expiresAt: 10_000, consentGeneration: 1, consentedAt: 90 })
+const active = () => {
+  const offered = offer(); assert.ok(offered)
+  const accepted = acceptBarberAppointment(offered, ACTOR, offered.revision, look, 1, 101, SESSION)
+  assert.ok(accepted.ok && accepted.state)
+  assert.deepEqual(readBarberAppointment(accepted.state, ACTOR), accepted.state)
+  return accepted.state
+}
+function completePractice(): BarberPracticeState {
+  let state = startBarberPractice(barberLesson('basic')!.plan)
+  assert.ok(state)
+  for (const [tool, point] of [
+    ['comb', [0.25, 0.4]], ['comb', [0.4, 0.4]], ['comb', [0.55, 0.4]],
+    ['clippers', [0.25, 0.68]], ['clippers', [0.4, 0.68]], ['clippers', [0.55, 0.68]],
+    ['brush', [0.4, 0.42]], ['brush', [0.55, 0.42]], ['brush', [0.7, 0.42]],
+  ] as const) {
+    const next = stepBarberPractice(state, { tool, x: point[0], y: point[1], pressed: true }, barberLesson('basic')!.plan)
+    assert.ok(next.state); state = next.state
+  }
+  assert.equal(state.status, 'complete')
+  return state
+}
+
+test('only the existing body-compatible low-cut style is approved and the full before-look is fingerprinted', () => {
+  assert.ok(APPEARANCE.hair.man.includes('low-cut'))
+  const state = offer(); assert.ok(state)
+  assert.equal(state.terms.customerId, APPOINTMENT_CUSTOMER_ID)
+  assert.equal(state.terms.styleId, APPOINTMENT_STYLE_ID)
+  assert.equal(state.terms.gamePrice, NPC_APPOINTMENT_GAME_PAYMENT)
+  assert.equal(state.terms.approvedLook.hair, 'low-cut')
+  assert.equal(state.terms.approvedLook.outfit, look.outfit)
+  assert.equal(createConsentedBarberAppointment({ appointmentId: 'x', actorId: ACTOR, currentLook: { ...look, body: 'woman' },
+    issuedAt: 100, expiresAt: 200, consentGeneration: 1, consentedAt: 90 }), null)
+  assert.equal(createConsentedBarberAppointment({ appointmentId: 'x', actorId: ACTOR, currentLook: { ...look, hair: 'low-cut' },
+    issuedAt: 100, expiresAt: 200, consentGeneration: 1, consentedAt: 90 }), null)
+  assert.equal(createConsentedBarberAppointment({ appointmentId: 'x', actorId: ACTOR, currentLook: { ...look, accessories: ['glasses', 'sunglasses'] },
+    issuedAt: 100, expiresAt: 200, consentGeneration: 1, consentedAt: 90 }), null, 'look validation follows onboarding’s one-accessory-per-slot rule')
+})
+
+test('strict reload retains the offer unchanged and rejects extra, accessor, future, and impossible terminal fields', () => {
+  const state = offer(); assert.ok(state)
+  assert.deepEqual(readBarberAppointment(JSON.parse(JSON.stringify(state)), ACTOR), state)
+  assert.equal(readBarberAppointment({ ...state, passed: true }, ACTOR), null)
+  assert.equal(readBarberAppointment({ ...state, version: 2 }, ACTOR), null)
+  const accessor = { ...state }; Object.defineProperty(accessor, 'status', { get: () => 'offered' })
+  assert.equal(readBarberAppointment(accessor, ACTOR), null)
+  assert.equal(readBarberAppointment({ ...state, status: 'completed', result: null }, ACTOR), null)
+  assert.equal(readBarberAppointment(state, 'another-actor'), null)
+})
+
+test('acceptance is revision-, appearance-, consent-generation-, and expiry-bound', () => {
+  const state = offer(); assert.ok(state)
+  assert.equal(acceptBarberAppointment(state, ACTOR, state.revision + 1, look, 1, 101, SESSION).code, 'revision_conflict')
+  const altered = { ...look, outfitColor: 'red' }
+  assert.equal(acceptBarberAppointment(state, ACTOR, state.revision, altered, 1, 101, SESSION).state?.status, 'cancelled')
+  assert.equal(acceptBarberAppointment(state, ACTOR, state.revision, look, 2, 101, SESSION).state?.cancelReason, 'revoked')
+  assert.equal(acceptBarberAppointment(state, ACTOR, state.revision, look, 1, state.terms.expiresAt, SESSION).state?.cancelReason, 'expired')
+})
