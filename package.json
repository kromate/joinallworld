{
  "name": "joinallworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "vite build",
    "typecheck": "node --experimental-strip-types scripts/typecheck.ts",
    "test": "node --experimental-strip-types --test \"src/**/*.test.js\" \"src/**/*.test.ts\" \"server/**/*.test.js\" \"server/**/*.test.ts\"",
    "start": "node server/server.ts",
    "start:server": "node server/server.ts",
    "start:worker": "node --experimental-strip-types deploy/local.ts",
    "preview:campus": "vite --config src/campus/unilag/preview.config.ts",
    "preview:models": "node --experimental-strip-types src/models/tooling/dev.ts",
    "test:edge": "node --experimental-strip-types --test \"deploy/*.test.ts\"",
    "first-day": "node --experimental-strip-types scripts/first-day.ts",
    "first-minute": "node --experimental-strip-types scripts/first-minute.ts",
    "new-player": "node --experimental-strip-types scripts/new-player.ts",
    "two-players": "node --experimental-strip-types scripts/two-players.ts",
    "economy": "node --experimental-strip-types scripts/economy-sim.ts",
    "load": "node --experimental-strip-types scripts/load.ts",
    "world-load": "node --experimental-strip-types scripts/world-load.ts",
    "sentry:sourcemaps": "node --experimental-strip-types scripts/sentry-sourcemaps.ts"
  },
  "dependencies": {
    "@sentry/browser": "^11.4.0",
    "posthog-js": "^1.435.8",
    "three": "^0.180.0",
    "vite": "^7.1.0",
    "vue": "3.5.41",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/node": "24.19.0",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11"
  }
}
