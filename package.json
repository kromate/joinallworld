{
  "name": "joinallworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.js\" \"src/**/*.test.ts\" \"server/**/*.test.js\" \"server/**/*.test.ts\"",
    "start": "node server/server.js",
    "start:server": "node server/server.js",
    "start:worker": "node deploy/local.mjs",
    "preview:campus": "vite --config src/campus/unilag/preview.config.ts",
    "preview:models": "node --experimental-strip-types src/models/tooling/dev.ts",
    "test:edge": "node --test deploy/*.test.mjs",
    "first-day": "node scripts/first-day.mjs",
    "first-minute": "node scripts/first-minute.mjs",
    "new-player": "node scripts/new-player.mjs",
    "two-players": "node scripts/two-players.mjs",
    "economy": "node scripts/economy-sim.mjs",
    "load": "node scripts/load.mjs",
    "world-load": "node scripts/world-load.mjs",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^11.4.0",
    "posthog-js": "^1.435.8",
    "three": "^0.180.0",
    "vite": "^7.1.0",
    "vue": "3.5.41",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/node": "24.19.0",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11"
  }
}
