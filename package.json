{
  "name": "joinallworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#city-map/*": {
      "types": "./src/game/cities/*/map.ts",
      "browser": "./src/game/cities/*/map.ts",
      "node": "./src/game/cities/*/map.ts",
      "default": "./src/game/cities/map-unavailable.ts"
    },
    "#city-loaders": {
      "types": "./src/game/cities/loaders.generated.ts",
      "browser": "./src/game/cities/loaders.generated.ts",
      "node": "./src/game/cities/loaders.generated.ts",
      "default": "./src/game/cities/host-loaders.ts"
    },
    "#city-network": {
      "types": "./src/game/cities/network-static.ts",
      "browser": "./src/game/cities/network-lazy.ts",
      "node": "./src/game/cities/network-static.ts",
      "default": "./src/game/cities/network-static.ts"
    },
    "#word-dictionary": {
      "types": "./src/words/dictionary-source.ts",
      "browser": "./src/words/dictionary-source.ts",
      "node": "./src/words/dictionary-node.ts",
      "default": "./src/words/dictionary-asset.ts"
    },
    "#progression-provider": {
      "types": "./src/game/progression/source-provider.ts",
      "browser": "./src/game/progression/source-provider.ts",
      "node": "./src/game/progression/source-provider.ts",
      "default": "./src/game/progression/asset-provider.ts"
    },
    "#campus-navigation-data": {
      "types": "./src/campus/unilag/navigation-data-source.ts",
      "browser": "./src/campus/unilag/navigation-data-source.ts",
      "node": "./src/campus/unilag/navigation-data-source.ts",
      "default": "./src/campus/unilag/navigation-data.generated.ts"
    }
  },
  "scripts": {
    "preflight": "node -e \"const v=process.versions.node.split('.').map(Number);if(v[0]<22||(v[0]===22&&v[1]<18)){console.error('Allworld needs Node.js 22.18 or newer (24 is recommended); this is '+process.versions.node+'. Install a newer one from https://nodejs.org/ or run: nvm install (it reads .nvmrc).');process.exit(1)}if(!require('fs').existsSync('node_modules/vite')){console.error('The dependencies are not installed yet. Run this first: npm install');process.exit(1)}\"",
    "predev": "npm run -s preflight",
    "predev:open": "npm run -s preflight",
    "prestart:open": "npm run -s preflight",
    "prebuild": "npm run -s preflight && npm run -s cities:catalogue -- --check && npm run -s cities:land:check && npm run -s progression:check && npm run -s progression:assets -- --check && npm run -s campus:navigation -- --check && node --experimental-strip-types scripts/assets/versions.ts --check && npm run -s scenes:check && npm run -s talk:check",
    "pretypecheck": "npm run -s preflight",
    "pretest": "npm run -s preflight && npm run -s cities:land:check && npm run -s cities:assets && npm run -s words:assets && npm run -s progression:assets && npm run -s campus:navigation -- --check && npm run -s talk:check",
    "prestart": "npm run -s preflight",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:open": "node --experimental-strip-types scripts/dev.ts --open",
    "start:open": "node --experimental-strip-types scripts/open-dev.ts start",
    "dev:fund": "node --experimental-strip-types scripts/open-dev.ts fund",
    "dev:seed": "node --experimental-strip-types scripts/open-dev.ts seed",
    "build": "vite build && npm run cities:assets && npm run words:assets && npm run progression:assets",
    "check": "npm run typecheck && npm run build && npm test",
    "test:smoke": "node --experimental-strip-types --test --test-concurrency=1 src/app/entry.test.ts server/release.test.ts src/types/protocol.test.ts",
    "check:fast": "npm run typecheck && npm run build && npm run size:download && npm run cartridge:check && npm run test:smoke",
    "check:full": "npm run check && npm run size:download && npm run test:edge",
    "geo:boundaries": "node --experimental-strip-types scripts/geo/build-boundaries.ts",
    "body:build": "node --experimental-strip-types scripts/body/build-body.ts",
    "body:lod": "node --experimental-strip-types scripts/body/build-lod.ts",
    "typecheck": "node --experimental-strip-types scripts/typecheck.ts --serial",
    "talk:build": "node --experimental-strip-types scripts/talk-factory/world.ts build",
    "talk:check": "node --experimental-strip-types scripts/talk-factory/world.ts check",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"src/**/*.test.js\" \"src/**/*.test.ts\" \"server/**/*.test.js\" \"server/**/*.test.ts\" \"scripts/city/*.test.ts\" \"scripts/scene-factory/*.test.ts\" \"scripts/talk-factory/*.test.ts\" \"scripts/stt-bench/*.test.ts\" \"scripts/agent-slot.test.ts\" \"scripts/typecheck.test.ts\" \"scripts/download-budget.test.ts\" \"scripts/cartridge-check.test.ts\" \"scripts/clip.test.ts\" \"scripts/build-dictionary-asset.test.ts\" \"scripts/assets/*.test.ts\" \"scripts/vite/*.test.ts\" \"scripts/evidence/*.test.ts\"",
    "slot": "node --experimental-strip-types scripts/agent-slot.ts",
    "check:slot": "node --experimental-strip-types scripts/agent-slot.ts heavy -- npm run check",
    "test:slot": "node --experimental-strip-types scripts/agent-slot.ts heavy -- npm test",
    "build:slot": "node --experimental-strip-types scripts/agent-slot.ts heavy -- npm run build",
    "typecheck:slot": "node --experimental-strip-types scripts/agent-slot.ts heavy -- npm run typecheck",
    "size:download": "node --experimental-strip-types scripts/download-budget.ts",
    "cartridge:check": "node --experimental-strip-types scripts/cartridge-check.ts",
    "clip": "node --experimental-strip-types scripts/clip.ts",
    "start": "node server/server.ts",
    "start:server": "node server/server.ts",
    "start:worker": "node --experimental-strip-types deploy/local.ts",
    "preview:campus": "vite --config src/campus/unilag/preview.config.ts",
    "preview:models": "node --experimental-strip-types src/models/tooling/dev.ts",
    "test:edge": "node --experimental-strip-types --test --test-concurrency=1 \"deploy/*.test.ts\"",
    "first-day": "node --experimental-strip-types scripts/first-day.ts",
    "first-minute": "node --experimental-strip-types scripts/first-minute.ts",
    "new-player": "node --experimental-strip-types scripts/new-player.ts",
    "two-players": "node --experimental-strip-types scripts/two-players.ts",
    "two-cities": "node --experimental-strip-types scripts/two-cities.ts",
    "economy": "node --experimental-strip-types scripts/economy-sim.ts",
    "load": "node --experimental-strip-types scripts/load.ts",
    "world-load": "node --experimental-strip-types scripts/world-load.ts",
    "capacity": "node --experimental-strip-types scripts/capacity.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "sentry:sourcemaps": "node --experimental-strip-types scripts/sentry-sourcemaps.ts",
    "cities:build": "node --experimental-strip-types scripts/city/build-city.ts",
    "cities:catalogue": "node --experimental-strip-types scripts/city/build-catalogue.ts",
    "cities:land:check": "node --experimental-strip-types scripts/city/check-land-components.mjs",
    "cities:assets": "node --experimental-strip-types scripts/city/build-content-assets.ts --out dist/assets/cities --typescript src/game/cities/content-assets.generated.ts",
    "words:assets": "node --experimental-strip-types scripts/build-dictionary-asset.ts --out dist/assets/words --typescript src/words/dictionary-asset.generated.ts",
    "progression:content": "node --experimental-strip-types scripts/city/build-progression-content.ts",
    "progression:check": "node --experimental-strip-types scripts/city/build-progression-content.ts --check",
    "progression:assets": "node --experimental-strip-types scripts/city/build-progression-assets.ts --out dist/assets/progression --typescript src/game/progression/assets.generated.ts",
    "campus:navigation": "node --experimental-strip-types scripts/campus/build-navigation-data.ts",
    "assets:versions": "node --experimental-strip-types scripts/assets/versions.ts",
    "assets:budget": "node --experimental-strip-types scripts/assets/budget.ts",
    "assets:credits": "node --experimental-strip-types scripts/assets/credits.ts",
    "scenes:build": "node --max-old-space-size=512 --experimental-strip-types scripts/scene-factory/scenes.ts build",
    "scenes:check": "node --max-old-space-size=512 --experimental-strip-types scripts/scene-factory/scenes.ts check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@sentry/browser": "^11.4.0",
    "meshoptimizer": "^0.22.0",
    "n8ao": "2.0.1",
    "posthog-js": "^1.435.8",
    "postprocessing": "6.39.5",
    "three": "^0.180.0",
    "vite": "^7.1.0",
    "vue": "3.5.41",
    "ws": "^8.22.0"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/node": "24.19.0",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.8",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11"
  }
}
